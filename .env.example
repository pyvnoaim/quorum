# copy to .env — `npm run dev` loads it via --env-file.
DISCORD_BOT_TOKEN=

# the dashboard. unset the id/secret and it just doesn't start.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_URL=http://localhost:3000
PORT=3000

# sqlite file, defaults to ./pug.db
DB_PATH=

# comma-separated server ids the bot may run in. Leave empty for no limit; set
# it and the bot leaves anywhere else on sight.
ALLOWED_GUILD_IDS=
