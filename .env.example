# copy to .env — `npm run dev` loads it via --env-file.
DISCORD_BOT_TOKEN=
# where results get posted. unset = the channel the match was opened in.
RESULTS_CHANNEL_ID=
# category to make each match's temporary voice channel in. unset = no voice.
VOICE_CATEGORY_ID=
# sqlite file, defaults to ./pug.db
DB_PATH=
