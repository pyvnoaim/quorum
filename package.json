{
  "name": "scrim-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "tsx src/rating.test.ts && NODE_OPTIONS=--experimental-sqlite tsx src/db.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^25",
    "tsx": "^4.22.4",
    "typescript": "^6"
  }
}
